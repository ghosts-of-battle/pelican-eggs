#!/bin/bash
# The egg's startup. Writes the Mumble server's config from the egg's
# variables, prepares its database, and runs the server. ^C stops it.
#
# The database, on every start:
# - SUPERUSER_PASSWORD set: it becomes the SuperUser's password (the admin
#   account in the Mumble app). A new database with none gets a random one.
# - TEMP_CHANNELS true: everyone may make a temporary channel under the root.
#   The JMSB mod makes one per mission (its room) and needs this: stock
#   Mumble allows it to registered users only. Off, every mission shares the
#   root channel, which still works but sends every voice to everyone.
DIR=/home/container
INI=${DIR}/mumble-server.ini
DB=${DIR}/mumble-server.sqlite
# Mumble's numbers: the first virtual server, the root channel, and the
# "make temporary channel" permission bit.
SERVER_ID=1
ROOT_CHANNEL=0
MAKE_TEMP_CHANNEL=1024
# Where our rule sits among the root channel's (stock ones are 1-3).
ACL_PRIORITY=50
RANDOM_PASSWORD_BYTES=24

# A value as Mumble's ini wants it: quoted, with \ and " escaped.
ini_value() {
    local v=${1//\\/\\\\}
    printf '"%s"' "${v//\"/\\\"}"
}

cat > "${INI}" <<EOF
database=${DB}
port=${SERVER_PORT}
serverpassword=$(ini_value "${MUMBLE_PASSWORD}")
users=${MUMBLE_USERS}
welcometext=
logfile=
EOF

supw=${SUPERUSER_PASSWORD}
if [ -z "${supw}" ] && [ ! -f "${DB}" ]; then
    supw=$(head -c ${RANDOM_PASSWORD_BYTES} /dev/urandom | base64)
fi
if [ -n "${supw}" ]; then
    # makes the database when there is none, sets the password, and exits
    mumble-server -ini "${INI}" -supw "${supw}" 2>&1 | grep -v "capabilities"
fi

if [ "${TEMP_CHANNELS}" = "true" ]; then
    sqlite3 "${DB}" "INSERT INTO acl (server_id, channel_id, priority, user_id, group_name, apply_here, apply_sub, grantpriv, revokepriv)
        SELECT ${SERVER_ID}, ${ROOT_CHANNEL}, ${ACL_PRIORITY}, NULL, 'all', 1, 1, ${MAKE_TEMP_CHANNEL}, NULL
        WHERE NOT EXISTS (SELECT 1 FROM acl WHERE server_id = ${SERVER_ID} AND channel_id = ${ROOT_CHANNEL} AND priority = ${ACL_PRIORITY});"
    echo "temporary channels: everyone"
else
    sqlite3 "${DB}" "DELETE FROM acl WHERE server_id = ${SERVER_ID} AND channel_id = ${ROOT_CHANNEL} AND priority = ${ACL_PRIORITY};"
    echo "temporary channels: registered users only (Mumble's default)"
fi

mumble-server -fg -ini "${INI}" &
server=$!
trap 'kill -INT $server 2>/dev/null' INT TERM
wait $server
wait
